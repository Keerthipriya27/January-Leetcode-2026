class Solution:
    def minimumPairRemoval(self, nums):
        n = len(nums)
        if n <= 1:
            return 0
        left = [-1] + list(range(n - 1))
        right = list(range(1, n)) + [-1]
        alive = [True] * n
        bad = 0
        for i in range(n - 1):
            if nums[i] > nums[i + 1]:
                bad += 1
        if bad == 0:
            return 0
        pq = []
        for i in range(n - 1):
            heapq.heappush(pq, (nums[i] + nums[i + 1], i))
        ops = 0
        while bad > 0:
            s, i = heapq.heappop(pq)
            j = right[i]
            if j == -1 or not alive[i] or not alive[j]:
                continue
            if nums[i] + nums[j] != s:
                continue
            li = left[i]
            rj = right[j]
            if li != -1 and nums[li] > nums[i]:
                bad -= 1
            if nums[i] > nums[j]:
                bad -= 1
            if rj != -1 and nums[j] > nums[rj]:
                bad -= 1
            nums[i] = s
            alive[j] = False
            right[i] = rj
            if rj != -1:
                left[rj] = i
            if li != -1 and nums[li] > nums[i]:
                bad += 1
            if rj != -1 and nums[i] > nums[rj]:
                bad += 1
            if li != -1 and alive[li]:
                heapq.heappush(pq, (nums[li] + nums[i], li))
            if rj != -1 and alive[rj]:
                heapq.heappush(pq, (nums[i] + nums[rj], i))
            ops += 1
        return ops
