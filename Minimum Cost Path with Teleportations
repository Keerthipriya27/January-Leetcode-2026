class Solution:
    def minCost(self, grid: list[list[int]], k: int) -> int:
        rows, cols = len(grid), len(grid[0])
        
        all_cells = []
        for row in range(rows):
            for col in range(cols):
                all_cells.append((row, col))
        
        all_cells.sort(key=lambda cell: grid[cell[0]][cell[1]])
        
        cost_matrix = [[float("inf") for _ in range(cols)] for _ in range(rows)]
        
        iterations = k + 1
        while iterations > 0:
            iterations -= 1
            
            current_min = float("inf")
            start_idx = 0
            
            idx = 0
            while idx < len(all_cells):
                row, col = all_cells[idx]
                current_min = min(current_min, cost_matrix[row][col])
                
                has_next = idx + 1 < len(all_cells)
                same_value = (has_next and 
                            grid[all_cells[idx][0]][all_cells[idx][1]] == 
                            grid[all_cells[idx + 1][0]][all_cells[idx + 1][1]])
                
                if same_value:
                    idx += 1
                    continue
                
                for pos in range(start_idx, idx + 1):
                    r, c = all_cells[pos]
                    cost_matrix[r][c] = current_min
                
                start_idx = idx + 1
                idx += 1
            
            for row in range(rows - 1, -1, -1):
                for col in range(cols - 1, -1, -1):
                    if row == rows - 1 and col == cols - 1:
                        cost_matrix[row][col] = 0
                    else:
                        if row < rows - 1:
                            neighbor_cost = cost_matrix[row + 1][col] + grid[row + 1][col]
                            cost_matrix[row][col] = min(cost_matrix[row][col], neighbor_cost)
                        
                        if col < cols - 1:
                            neighbor_cost = cost_matrix[row][col + 1] + grid[row][col + 1]
                            cost_matrix[row][col] = min(cost_matrix[row][col], neighbor_cost)
        
        return cost_matrix[0][0]
