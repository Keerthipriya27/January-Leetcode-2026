class Solution:
    def minimumAbsDifference(self, arr: List[int]) -> List[List[int]]:
        arr.sort()
        m = float('inf')
        ans = []
        for i in range(1, len(arr)):
            d = arr[i] - arr[i - 1]
            if d < m:
                m = d
        for i in range(1, len(arr)):
            if arr[i] - arr[i - 1] == m:
                ans.append([arr[i - 1], arr[i]])
        return ans
